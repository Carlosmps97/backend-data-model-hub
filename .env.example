# ─── Azure AI Foundry ───────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL=gpt-4o
FOUNDRY_API_KEY=your-foundry-api-key

# ─── Azure Service Principal ────────────────────────────────────
APP_AZURE_TENANT_ID=your-tenant-id
APP_AZURE_CLIENT_ID=your-client-id
APP_AZURE_CLIENT_SECRET=your-client-secret

# ─── Azure OpenAI (alternativo) ────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ─── Embeddings y búsqueda vectorial semántica ─────────────────
# Nombre del deployment de text-embedding-3-small en Azure AI Foundry.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Umbral mínimo de similitud coseno para reutilizar una columna histórica.
# Rango: 0.0–1.0. Default: 0.85 (conservador).
VECTOR_SIMILARITY_THRESHOLD=0.85

# ─── Azure Cosmos DB for MongoDB (vCore) ───────────────────────
COSMOS_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
COSMOS_DATABASE=db_modeler

# ─── Rutas de datos ────────────────────────────────────────────
GUIDELINES_PATH=data/guidelines/modeling_guidelines.json
COLUMN_CATALOG_PATH=data/column_catalog.json

# ─── Motor de BD por defecto ───────────────────────────────────
DEFAULT_DB_ENGINE=databricks_sql

# ─── Autenticación JWT ─────────────────────────────────────────
# Secreto HS256 para firmar tokens de sesión. Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=your-auth-secret-here

# ─── API REST ──────────────────────────────────────────────────
# Máximo de pipelines de modelamiento ejecutándose concurrentemente.
# Solo afecta a POST /api/conversations/{id}/model.
MAX_CONCURRENT_PIPELINES=5

# Orígenes permitidos por CORS, separados por coma.
# Default: localhost:3000 y 127.0.0.1:3000 (Next.js dev).
# Ejemplo: CORS_ORIGINS=http://localhost:3000,https://modeler.example.com
# CORS_ORIGINS=

# ─── Performance / Rate limiting del LLM ──────────────────────
# Tope de tokens de salida (red de seguridad). El sistema chunked
# garantiza que cada llamada al LLM nunca se acerque a este número.
# Subilo si usás un modelo con output >32K (gpt-5: 128K). Default: 32000.
AGENT_MAX_OUTPUT_TOKENS=32000

# Cap de RPM (Requests Per Minute) que el backend respeta antes de
# llamar al LLM. Cuando se llega al cap, las nuevas llamadas esperan
# hasta que la ventana de 60 s libere cupo. Ajustá según tu quota de
# Azure OpenAI. Default: 30 (conservador para gpt-4o single deployment).
LLM_RPM_CAP=30

# Tablas procesadas en paralelo dentro de un mismo request en modo
# per-tabla (cuando se sube un Excel). Cada tabla = 1+ llamada al LLM
# según su número de columnas (chunking interno). Default: 2.
PER_TABLE_PARALLELISM=2

# Tamaño máximo de un sub-batch de columnas dentro de una tabla.
# Cuando una tabla tiene MÁS columnas que esto, se parte en chunks de
# este tamaño y cada uno se procesa como una llamada al LLM
# independiente, garantizando que nunca se trunque la salida.
# Default: 25 (margen seguro para gpt-4o output ~16K).
COLS_PER_BATCH=25

# Reintentos máximos cuando Azure responde 429. Backoff escalado
# 5/15/30/45 s. Default: 4.
LLM_MAX_RETRIES=4

# ─── Logging ───────────────────────────────────────────────────
# Formato de logs: "pretty" (legible para dev) o "json" (producción).
LOG_FORMAT=pretty
# Nivel mínimo de log: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
