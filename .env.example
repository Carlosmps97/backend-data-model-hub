# Plantilla del .env de DESARROLLO LOCAL (copiar a `.env` y completar).
# Homologación (doc 28 §11): estas mismas claves son las que en Databricks
# Apps llegan por el bloque `config.env` del bundle (databricks.yml,
# sección `variables:`); GitHub Actions solo usa DATABRICKS_HOST +
# DATABRICKS_TOKEN para el CLI. Ningún valor por-entorno vive en el código.

# ─── Backend de BD (doc 28) ────────────────────────────────────
# Databricks Lakebase Postgres es la BD oficial. `cosmos` sigue existiendo
# solo como camino de rollback a nivel de código (adaptador app/core/db/): si
# alguna vez lo necesitas, pon DB_BACKEND=cosmos y define COSMOS_CONNECTION_STRING
# + COSMOS_DATABASE. En operación normal no se necesita nada de Cosmos.
DB_BACKEND=lakebase

# ─── Databricks Lakebase Postgres (doc 28) ─────────────────────
# El PAT (DATABRICKS_TOKEN) autentica el SDK ante el workspace; el password
# real de Postgres es un token OAuth de ~1h que el backend acuña solo.
# (En Databricks Apps NO van: el service principal de la app los reemplaza.)
DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
# DATABRICKS_TOKEN es OPCIONAL: si tu workspace no deja crear PATs, corre
# `databricks auth login --host <workspace>` (OAuth por navegador) y déjala
# VACÍA — el SDK toma esa credencial sola. Si el perfil no es el DEFAULT,
# indícalo con DATABRICKS_CONFIG_PROFILE=<perfil>.
# Ojo: PGUSER debe ser la identidad que autentica (con OAuth = tu correo).
DATABRICKS_TOKEN=dapi<...>
# Ruta LÓGICA del endpoint — misma en cualquier workspace que respete la
# convención de nombres (proyecto dmh-proj · branch production · endpoint primary).
LAKEBASE_ENDPOINT=projects/dmh-proj/branches/production/endpoints/primary
# PGHOST es OPCIONAL (se resuelve solo desde LAKEBASE_ENDPOINT vía SDK);
# seteado te ahorra esa llamada en cada arranque de dev.
# PGHOST=ep-<...>.database.<region>.azuredatabricks.net
PGPORT=5432
# Rol de Postgres = tu identidad Databricks (correo del workspace). En Apps
# no se setea (cae al DATABRICKS_CLIENT_ID del service principal).
PGUSER=<tu-correo-del-workspace>
PGDATABASE=databricks_postgres
PGSSLMODE=require
# PGPASSWORD: atajo SOLO para correr scripts desde una máquina donde no se
# puede autenticar el SDK. Es el token que la consola de Lakebase deja copiar
# (Connect > Copy OAuth token) y dura ~1 h. Con PGPASSWORD + PGHOST no se
# necesitan DATABRICKS_TOKEN ni LAKEBASE_ENDPOINT. Nunca se usa en la app.
# PGPASSWORD=
# Schema PG donde viven las "colecciones" (tablas id+doc jsonb).
LAKEBASE_PGSCHEMA=dmh

# ─── Sesión (JWT HS256, token-first) ───────────────────────────
# SECRET_KEY firma los tokens de sesión. En dev se puede omitir (usa un
# default inseguro y el backend lo advierte); con REQUIRE_AUTH=true es
# OBLIGATORIA (en Apps llega desde el secreto del bundle).
# SECRET_KEY=
# REQUIRE_AUTH=false

# ─── CORS ──────────────────────────────────────────────────────
# Default: localhost:3000 / 127.0.0.1:3000 (front Vite en dev).
# CORS_ORIGINS=http://localhost:3000,https://modeler.example.com
# CORS_ORIGIN_REGEX=https://frnt-data-model-hub-.*\.databricksapps\.com

# ─── Logging ───────────────────────────────────────────────────
# Formato: "pretty" (dev) o "json" (producción). Nivel: DEBUG…CRITICAL.
LOG_FORMAT=pretty
LOG_LEVEL=INFO
